{
  "name": "dvncyzm",
  "version": "0.1.0",
  "description": "Aplikasi desktop untuk memudahkan pekerjaan Android sehari-hari",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.11",
    "@vitejs/plugin-vue": "^6.0.11",
    "autoprefixer": "^10.7.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.46"
  }
}