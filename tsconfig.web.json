{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "jsx": "preserve", "lib": ["ES2022", "DOM"],
    "paths": { "@renderer/*": ["./src/renderer/src/*"] }, "noEmit": true
  },
  "include": ["src/renderer/src/**/*", "src/renderer/src/**/*.vue", "src/preload/index.ts", "src/preload/global.d.ts", "src/shared/**/*"]
}
